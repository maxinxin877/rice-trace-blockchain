# =====================================================================
# 部署环境变量模板：复制为 .env 后按需修改（.env 已被 git 忽略，不会提交）
#   cp .env.example .env
# =====================================================================

# ---------- 必填：数据库 root 密码 ----------
# 生成方式：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=请改成你自己的强密码

# ---------- 必填：JWT 签名密钥（HS384，长度必须 >= 48 个字符）----------
# 生成方式：openssl rand -base64 48
JWT_SECRET=请改成至少48个字符的随机字符串abcdefghijklmnopqrstuvwxyz0123456789

# ---------- 可选 ----------
# 站点对外端口（默认 80；若已被占用可改成 8000 等，访问 http://IP:8000/）
HTTP_PORT=80
# 令牌有效期（秒），默认 12 小时
JWT_EXPIRE_SECONDS=43200

# FISCO BCOS：false = 不连链，上链动作模拟成功（演示推荐）
BCOS_ENABLED=false
# 接入真实链后填写 Evidence 合约地址，形如 0x1234...
BCOS_CONTRACT_ADDRESS=

# 构建镜像源（国内服务器默认走阿里云 / npmmirror；改回官方源填空以外的地址）
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com

# JVM 参数（内存较小的服务器可调小，如 -XX:MaxRAMPercentage=60）
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8
